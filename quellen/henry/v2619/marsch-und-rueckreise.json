    "ui_verhalten": {
      "ziel_ort_button_label_bei_erledigt": "Rückkehr nach {auftraggeber_ort} antreten",
      "abgabe_button_nur_am_zielort_aktiv": true,
      "karten_zielmarker_farbe": "#d97706"
    }
  },
  "akt1_beispiel_hagenfels": {
    "quest_id": "hq_akt1_schritt2_verbranntes_korn",
    "auftraggeber_ort": "kronstadt_burg",
    "einsatz_ort": "hagenfels_westmark",
    "abgabe_vor_ort": false,
    "phasen": [
      { "phase": "hinmarsch", "route": ["kronstadt_burg", "westmark_ebene", "hagenfels_westmark"],
        "vignette": "Der Wind trägt den Geruch verbrannten Korns von den Höfen bei Hagenfels herüber." },
      { "phase": "einsatz", "ort": "hagenfels_westmark", "aktion": "Verteidigung der Höfe gegen Deserteure und Plünderer" },
      { "phase": "rueckmarsch", "route": ["hagenfels_westmark", "westmark_ebene", "kronstadt_burg"],
        "vignette": "Die Höfe der Westmark sind gesichert. Nun gilt es, die Nachricht vor den Thron zu bringen." }
    ]
  }
